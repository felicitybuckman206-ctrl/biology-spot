
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Biology Spot</title>
<style>
:root {
  --green: #315b40;
  --light: #e8efdf;
  --cream: #f8f7ef;
  --text: #304638;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: var(--cream);
  color: var(--text);
}
header {
  background: var(--light);
  padding: 20px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}
.logo {
  font-size: 27px;
  font-weight: bold;
  letter-spacing: 2px;
  color: var(--green);
}
nav { display: flex; gap: 20px; }
nav a {
  text-decoration: none;
  color: var(--green);
  font-weight: bold;
}
nav a:hover { text-decoration: underline; }
.hero {
  text-align: center;
  padding: 90px 20px;
  background:
    linear-gradient(#203e2c99,#203e2c99),
    url("https://images.unsplash.com/photo-1532094349884-543bc11b234d?w=1600")
    center/cover;
  color: white;
}
.hero h1 { font-size: clamp(36px,6vw,65px); margin: 0 0 15px; }
.hero p { font-size: 18px; }
.hero a {
  display: inline-block;
  margin-top: 20px;
  background: #e8efdf;
  color: var(--green);
  padding: 14px 28px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: bold;
}
section { padding: 55px 8%; }
.section-title {
  text-align: center;
  font-size: 30px;
  color: var(--green);
}
.intro {
  text-align: center;
  max-width: 650px;
  margin: auto;
  line-height: 1.7;
}
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(210px,1fr));
  gap: 20px;
  margin-top: 30px;
}
.card {
  background: white;
  border-radius: 13px;
  overflow: hidden;
  box-shadow: 0 3px 13px #00000010;
}
.card .picture {
  height: 140px;
  display: grid;
  place-items: center;
  font-size: 65px;
  background: var(--light);
}
.card-content { padding: 20px; }
.card h3 { margin-top: 0; }
.games-section { background: var(--light); }
input {
  display: block;
  width: min(100%,450px);
  padding: 13px;
  margin: 25px auto;
  border: 1px solid #b9cbb7;
  border-radius: 8px;
  font-size: 16px;
}
button {
  cursor: pointer;
  background: var(--green);
  color: white;
  padding: 11px 20px;
  border: 0;
  border-radius: 7px;
  font-size: 15px;
}
button:hover { opacity: .85; }
.game-panel {
  display: none;
  background: white;
  padding: 25px;
  margin-top: 25px;
  border-radius: 12px;
  text-align: center;
}
.game-panel.active { display: block; }
.memory-grid {
  display: grid;
  grid-template-columns: repeat(4,65px);
  justify-content: center;
  gap: 9px;
  margin: 20px auto;
}
.memory-grid button {
  height: 65px;
  font-size: 25px;
  padding: 0;
  background: #dce9d7;
  color: var(--green);
}
footer {
  background: #294936;
  color: white;
  text-align: center;
  padding: 35px 20px;
}
footer a { color: #dcebd7; }
footer p { line-height: 1.7; }
.hidden { display: none; }
</style>
</head>
<body>

<header>
  <div class="logo">BIOLOGY SPOT 🌿</div>
  <nav>
    <a href="#home">Home</a>
    <a href="#biology">Biology</a>
    <a href="#games">Games</a>
    <a href="#info">Info</a>
  </nav>
</header>

<main>
<section class="hero" id="home">
  <h1>Discover the Science of Life</h1>
  <p>Explore, learn, and discover the world of biology.</p>
  <a href="#biology">Explore Biology</a>
</section>

<section id="biology">
  <h2 class="section-title">Explore Biology</h2>
  <p class="intro">
    Biology is the study of living things. Discover cells,
    genetics, the human body, and the amazing ecosystems
    that make up our planet.
  </p>

  <div class="grid">
    <article class="card">
      <div class="picture">🔬</div>
      <div class="card-content">
        <h3>Cell Biology</h3>
        <p>Discover how cells work and what makes up living organisms.</p>
      </div>
    </article>
    <article class="card">
      <div class="picture">🧬</div>
      <div class="card-content">
        <h3>Genetics</h3>
        <p>Learn about DNA, genes, and inherited traits.</p>
      </div>
    </article>
    <article class="card">
      <div class="picture">🫀</div>
      <div class="card-content">
        <h3>Human Biology</h3>
        <p>Explore the organs and systems of the human body.</p>
      </div>
    </article>
    <article class="card">
      <div class="picture">🌎</div>
      <div class="card-content">
        <h3>Ecosystems</h3>
        <p>Discover animals, plants, habitats, and nature.</p>
      </div>
    </article>
  </div>
</section>

<section class="games-section" id="games">
  <h2 class="section-title">Games & Activities 🎮</h2>
  <p class="intro">Take a break and enjoy some interactive games!</p>

  <input id="search" placeholder="Search games..."
    oninput="searchGames()">

  <div class="grid" id="gameList">
    <article class="card game-card">
      <div class="picture">🧠</div>
      <div class="card-content">
        <h3>Biology Quiz</h3>
        <p>Test your biology knowledge!</p>
        <button onclick="openGame('quiz')">Play Now</button>
      </div>
    </article>

    <article class="card game-card">
      <div class="picture">🃏</div>
      <div class="card-content">
        <h3>Memory Match</h3>
        <p>Find matching pairs of cards.</p>
        <button onclick="openGame('memory')">Play Now</button>
      </div>
    </article>
  </div>

  <div id="quiz" class="game-panel">
    <h2>Biology Quiz 🧠</h2>
    <p id="question"></p>
    <div id="answers"></div>
    <p id="quizResult"></p>
    <button onclick="nextQuestion()" id="nextButton" class="hidden">Next Question</button>
  </div>

  <div id="memory" class="game-panel">
    <h2>Memory Match 🃏</h2>
    <p>Find all four matching pairs!</p>
    <div class="memory-grid" id="memoryGrid"></div>
    <p id="memoryResult"></p>
    <button onclick="startMemory()">Restart Game</button>
  </div>
</section>
</main>

<footer id="info">
  <h2>BIOLOGY SPOT</h2>
  <p>Created by Felicity</p>
  <p>Contact the Creator</p>
  <p>Instagram:
    <a href="https://www.instagram.com/fel_felicityy/"
       target="_blank" rel="noopener noreferrer">
       @fel_felicityy
    </a>
  </p>
  <p>Thanks for visiting Biology Spot! 🌿</p>
  <small>© 2026 Biology Spot</small>
</footer>

<script>
function searchGames() {
  const term = document.getElementById("search").value.toLowerCase();
  document.querySelectorAll(".game-card").forEach(card => {
    card.style.display =
      card.innerText.toLowerCase().includes(term) ? "" : "none";
  });
}

function openGame(id) {
  document.querySelectorAll(".game-panel").forEach(panel =>
    panel.classList.remove("active")
  );
  document.getElementById(id).classList.add("active");
  document.getElementById(id).scrollIntoView({behavior:"smooth"});
  if (id === "quiz") showQuestion();
  if (id === "memory") startMemory();
}

// BIOLOGY QUIZ
const questions = [
  {q:"What is the basic unit of life?",
   a:["Cell","Organ","Tissue","Atom"], correct:0},
  {q:"What molecule carries genetic information?",
   a:["Glucose","DNA","Water","Protein"], correct:1},
  {q:"What organ pumps blood around the body?",
   a:["Lungs","Brain","Heart","Liver"], correct:2},
  {q:"What process do plants use to make food?",
   a:["Digestion","Photosynthesis","Respiration","Fermentation"], correct:1},
  {q:"Which organelle produces much of a cell's energy?",
   a:["Nucleus","Ribosome","Mitochondrion","Cell wall"], correct:2}
];

let current = 0;
let score = 0;

function showQuestion() {
  document.getElementById("nextButton").classList.add("hidden");
  document.getElementById("quizResult").innerText = "";
  const q = questions[current];
  document.getElementById("question").innerText =
    (current+1) + ". " + q.q;
  const box = document.getElementById("answers");
  box.innerHTML = "";
  q.a.forEach((answer,i) => {
    const btn = document.createElement("button");
    btn.innerText = answer;
    btn.style.margin = "6px";
    btn.onclick = () => {
      if (i === q.correct) {
        score++;
        document.getElementById("quizResult").innerText = "Correct! 🌿";
      } else {
        document.getElementById("quizResult").innerText =
          "Not quite! The answer is " + q.a[q.correct] + ".";
      }
      box.querySelectorAll("button").forEach(b => b.disabled = true);
      document.getElementById("nextButton").classList.remove("hidden");
    };
    box.appendChild(btn);
  });
}

function nextQuestion() {
  current++;
  if (current >= questions.length) {
    document.getElementById("question").innerText =
      "Quiz complete!";
    document.getElementById("answers").innerHTML = "";
    document.getElementById("quizResult").innerText =
      "You scored " + score + " out of " + questions.length + "!";
    document.getElementById("nextButton").innerText = "Play Again";
    document.getElementById("nextButton").onclick = () => {
      current = 0;
      score = 0;
      document.getElementById("nextButton").innerText = "Next Question";
      document.getElementById("nextButton").onclick = nextQuestion;
      showQuestion();
    };
  } else {
    showQuestion();
  }
}

// MEMORY GAME
const symbols = ["🌱","🧬","🔬","🦋"];
let first = null;
let locked = false;
let matched = 0;

function startMemory() {
  const grid = document.getElementById("memoryGrid");
  grid.innerHTML = "";
  first = null;
  locked = false;
  matched = 0;
  document.getElementById("memoryResult").innerText = "";

  [...symbols,...symbols].sort(() => Math.random()-.5).forEach(symbol => {
    const btn = document.createElement("button");
    btn.innerText = "?";
    btn.dataset.symbol = symbol;
    btn.onclick = () => {
      if (locked || btn.disabled || btn === first) return;
      btn.innerText = symbol;
      if (!first) {
        first = btn;
      } else {
        if (first.dataset.symbol === symbol) {
          first.disabled = true;
          btn.disabled = true;
          first = null;
          matched++;
          if (matched === symbols.length) {
            document.getElementById("memoryResult").innerText =
              "You found every pair! 🎉";
          }
        } else {
          locked = true;
          const previous = first;
          first = null;
          setTimeout(() => {
            previous.innerText = "?";
            btn.innerText = "?";
            locked = false;
          },800);
        }
      }
    };
    grid.appendChild(btn);
  });
}
</script>
</body>
</html>
